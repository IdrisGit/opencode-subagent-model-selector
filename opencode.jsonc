{
	"$schema": "https://opencode.ai/config.json",
	"plugin": [
		[
			"@idrisgit/opencode-subagent-model-selector",
			{
				"routes": [
					// OpenAI/Codex Models
					// GPT-Sol
					{
						"primary": {
							"model": "openai/gpt-5.6-sol"
						},
						"subagents": {
							"explore": {
								"model": "openai/gpt-5.6-luna",
								"variant": "medium"
							},
							"general": {
								"model": "openai/gpt-5.6-terra",
								"variant": "medium"
							}
						}
					},
					{
						"primary": {
							"model": "openai/gpt-5.6-sol",
							"variant": ["high", "xhigh", "max"]
						},
						"subagents": {
							"explore": {
								"model": "openai/gpt-5.6-terra",
								"variant": "medium"
							},
							"general": {
								"model": "openai/gpt-5.6-terra",
								"variant": "high"
							}
						}
					},
					// GPT-Terra
					{
						"primary": {
							"model": "openai/gpt-5.6-terra"
						},
						"subagents": {
							"explore": {
								"model": "openai/gpt-5.6-luna",
								"variant": "low"
							}
						}
					},
					{
						"primary": {
							"model": "openai/gpt-5.6-terra",
							"variant": ["xhigh", "max"]
						},
						"subagents": {
							"explore": {
								"model": "openai/gpt-5.6-terra",
								"variant": "medium"
							}
						}
					},
					// OpenCode Go Models
					// Kimi K3
					{
						"primary": {
							"model": "opencode-go/kimi-k3"
						},
						"subagents": {
							"explore": {
								"model": "opencode-go/deepseek-v4-pro"
							},
							"general": {
								"model": "opencode-go/deepseek-v4-pro",
								"variant": "max"
							}
						}
					},
					// GLM-5.2
					{
						"primary": {
							"model": "opencode-go/glm-5.2"
						},
						"subagents": {
							"explore": {
								"model": "opencode-go/deepseek-v4-pro"
							},
							"general": {
								"model": "opencode-go/deepseek-v4-pro",
								"variant": "max"
							}
						}
					},
					// Grok-4.5
					{
						"primary": {
							"model": "opencode-go/grok-4.5"
						},
						"subagents": {
							"explore": {
								"model": "opencode-go/deepseek-v4-pro"
							},
							"general": {
								"model": "opencode-go/deepseek-v4-pro",
								"variant": "max"
							}
						}
					}
				]
			}
		]
	]
}
